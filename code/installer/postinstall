#!/bin/bash
# Installer runs this as root; launch setup only in the active desktop user's session.
set -u

manual_setup() {
  echo "Ad Blocker: $1 Open /Applications/Ad Blocker.app manually to finish setup."
  exit 0
}

[[ "${3:-}" == "/" ]] || manual_setup "Setup was not started on a non-boot target."
[[ -d "/Applications/Ad Blocker.app" ]] || manual_setup "Installed app was not found."

console_user="$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null)" \
  || manual_setup "The active console user could not be read."
case "$console_user" in
  ''|root|loginwindow|_mbsetupuser) manual_setup "There is no active desktop user." ;;
esac
console_uid="$(/usr/bin/id -u "$console_user" 2>/dev/null)" \
  || manual_setup "The console user's UID could not be read."
[[ "$console_uid" =~ ^[0-9]+$ ]] && [[ "$console_uid" -ge 501 ]] \
  || manual_setup "There is no eligible desktop user."

if /bin/launchctl asuser "$console_uid" \
    /usr/bin/sudo -u "$console_user" -- \
    /usr/bin/open -n -g "/Applications/Ad Blocker.app" --args --setup; then
  echo "Ad Blocker: Setup launch requested in the active desktop session. Safari approval is still required."
else
  manual_setup "Setup could not be launched in the desktop session."
fi
exit 0
