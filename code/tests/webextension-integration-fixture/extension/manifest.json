{
  "manifest_version": 3,
  "name": "WKWebExtension integration smoke",
  "description": "Local-only WKWebExtension API integration fixture.",
  "version": "1.0.0",
  "permissions": ["scripting", "webNavigation"],
  "host_permissions": ["http://127.0.0.2/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.2/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://127.0.0.2/*"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
