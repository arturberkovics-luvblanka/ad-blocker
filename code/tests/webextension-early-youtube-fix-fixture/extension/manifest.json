{
  "manifest_version": 3,
  "name": "WKWebExtension early YouTube fix smoke",
  "description": "Static, local-only early YouTube scriptlet fixture.",
  "version": "1.0.0",
  "permissions": ["scripting", "webNavigation"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["early-youtube.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
