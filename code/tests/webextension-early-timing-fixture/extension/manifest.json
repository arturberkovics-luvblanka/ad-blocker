{
  "manifest_version": 3,
  "name": "WKWebExtension early timing smoke",
  "description": "Local-only model of delayed background scriptlet delivery.",
  "version": "1.0.0",
  "permissions": ["scripting", "webNavigation"],
  "host_permissions": ["http://127.0.0.2/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.2/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["http://127.0.0.2/*"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
